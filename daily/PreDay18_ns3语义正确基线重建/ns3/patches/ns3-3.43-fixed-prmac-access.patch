+void
+Txop::SetFixedPrmacReservedAccess(bool enabled, Time expires)
+{
+    NS_LOG_FUNCTION(this << enabled << expires);
+    m_fixedPrmacReserved = enabled;
+    m_fixedPrmacGrantExpires = enabled ? expires : Seconds(0);
+    m_fixedPrmacAccessTrace(enabled ? 1 : 0, m_fixedPrmacGrantExpires);
+}
+
+void
+Txop::SetFixedPrmacBlockedUntil(Time until)
+{
+    NS_LOG_FUNCTION(this << until);
+    m_fixedPrmacBlockedUntil = std::max(m_fixedPrmacBlockedUntil, until);
+    m_fixedPrmacAccessTrace(2, m_fixedPrmacBlockedUntil);
+}
+
+bool
+Txop::HasFixedPrmacReservedAccess() const
+{
+    return m_fixedPrmacReserved && Simulator::Now() < m_fixedPrmacGrantExpires;
+}
